# Database Configuration
DATABASE_URL=sqlite:///./database.db
SQL_ECHO=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
# JSON. Em produção precisa ser https, sem barra no fim, e nunca ["*"],
# senão a aplicação recusa subir.
CORS_ORIGINS=["http://localhost:3000"]

# Security
# Credencial exigida no header X-API-Key pelas rotas de escrita (POST/PUT/DELETE).
# Sem ela as rotas de escrita respondem 503. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Environment
ENVIRONMENT=development

# Lomadee
LOMADEE_API_KEY=your-lomadee-api-key-here
